<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CS2.Translator.UI.ViewModels"
    xmlns:models="using:CS2.Translator.Core.Models"
    xmlns:conv="using:Avalonia.Data.Converters"
    x:Class="CS2.Translator.UI.Views.MainView"
    x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.translation">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBlock.translation.pending">
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <Style Selector="TextBlock.translation.error">
            <Setter Property="Foreground" Value="#FF7B72"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="#3A3A5A"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.badgeText">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#C7C7E0"/>
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="#26263A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto"
          Background="#0E0E12">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#14141A"
                Padding="12"
                BorderBrush="#2E2E40"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock
                    Grid.Column="0"
                    Text="CS2 Translator"
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Foreground="White"/>

                <Button
                    Grid.Column="1"
                    Classes="toolbar"
                    Content="Clear"
                    Margin="0,0,8,0"
                    Command="{Binding ClearCommand}"/>

                <Button
                    Grid.Column="2"
                    Classes="toolbar"
                    Content="Reload"
                    Margin="0,0,8,0"
                    Command="{Binding ReloadCommand}"/>

                <Button
                    Grid.Column="3"
                    Content="Settings"
                    Command="{Binding OpenSettingsCommand}"
                    Padding="10,4"
                    Background="#3A3AF5"
                    Foreground="White"
                    CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- CHAT -->
        <ScrollViewer Grid.Row="1"
                      Padding="8"
                      x:Name="ChatScrollViewer">

            <ItemsControl x:Name="ChatItems" ItemsSource="{Binding Chats}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Chat">

                        <Border
                            Background="#1E1E26"
                            CornerRadius="8"
                            Padding="8,5"
                            Margin="0,0,0,4">

                            <!-- Name on the left, message to its right: chat lines are short
                                 and stacking them wasted most of the window width. -->
                            <Grid ColumnDefinitions="Auto,*">

                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top">

                                    <!-- One badge per type, each visible only when the message is
                                         that type AND its indicator is enabled. At most one shows. -->
                                    <Border Classes="badge">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                <Binding Path="IsTeamChat"/>
                                                <Binding Path="$parent[ItemsControl].((vm:MainViewModel)DataContext).ShowTeamIndicator"/>
                                            </MultiBinding>
                                        </Border.IsVisible>
                                        <TextBlock Classes="badgeText" Text="TEAM"/>
                                    </Border>

                                    <Border Classes="badge">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                <Binding Path="IsDeadChat"/>
                                                <Binding Path="$parent[ItemsControl].((vm:MainViewModel)DataContext).ShowDeadIndicator"/>
                                            </MultiBinding>
                                        </Border.IsVisible>
                                        <TextBlock Classes="badgeText" Text="DEAD"/>
                                    </Border>

                                    <Border Classes="badge" IsVisible="{Binding IsSpectatorChat}">
                                        <TextBlock Classes="badgeText" Text="SPEC"/>
                                    </Border>

                                    <!-- Capped so one long name cannot squeeze out the message -->
                                    <TextBlock
                                        Text="{Binding Name}"
                                        ToolTip.Tip="{Binding Name}"
                                        MaxWidth="150"
                                        TextTrimming="CharacterEllipsis"
                                        FontSize="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).NameFontSize}"
                                        Foreground="#AAAAAA"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock
                                        Classes="translation"
                                        Classes.pending="{Binding IsPending}"
                                        Classes.error="{Binding HasError}"
                                        Text="{Binding TranslationText}"
                                        FontSize="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).TranslationFontSize}"
                                        TextWrapping="Wrap"/>

                                    <!-- Original text, shown under the translation when enabled -->
                                    <StackPanel IsVisible="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ShowOriginalMessage}">
                                        <TextBlock
                                            Text="{Binding Message}"
                                            IsVisible="{Binding HasTranslation}"
                                            FontSize="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).TranslationFontSize}"
                                            TextWrapping="Wrap"
                                            Opacity="0.45"
                                            Foreground="White"/>
                                    </StackPanel>
                                </StackPanel>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
                Background="#14141A"
                BorderBrush="#2E2E40"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock
                Text="{Binding StatusText}"
                FontSize="11"
                TextWrapping="Wrap"
                Foreground="#8A8AA0"/>
        </Border>
    </Grid>
</UserControl>
