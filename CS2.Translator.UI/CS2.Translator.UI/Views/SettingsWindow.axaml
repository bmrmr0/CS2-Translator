<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CS2.Translator.UI.ViewModels"
    x:Class="CS2.Translator.UI.Views.SettingsWindow"
    Width="640"
    Height="640"
    Title="Settings"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    x:DataType="vm:SettingsViewModel">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.status.invalid">
            <Setter Property="Foreground" Value="#FF7B72"/>
        </Style>
    </Window.Styles>

    <Border Margin="12" Background="#252526" CornerRadius="8" Padding="16">
        <DockPanel>

            <!-- Buttons pinned to the bottom so the form can never push them off screen -->
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Spacing="8">
                <Button Content="Open data folder"
                        Command="{Binding OpenDataFolderCommand}"/>
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"/>
                <Button Content="Save"
                        Background="#3A3AF5"
                        Foreground="White"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>

            <ScrollViewer>
                <StackPanel Spacing="4">

                    <TextBlock Classes="label" Text="CS2 installation path"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding InstallationPath}"/>
                        <Button Grid.Column="1"
                                Content="Browse..."
                                Margin="8,0,0,0"
                                Command="{Binding BrowseCommand}"/>
                    </Grid>
                    <TextBlock Classes="status hint"
                               Classes.invalid="{Binding !PathIsValid}"
                               Text="{Binding PathStatus}"/>

                    <TextBlock Classes="label" Text="Translate into"/>
                    <AutoCompleteBox
                        Text="{Binding Language, Mode=TwoWay}"
                        ItemsSource="{Binding CommonLanguages}"
                        FilterMode="StartsWith"
                        MinimumPrefixLength="0"/>
                    <TextBlock Classes="hint"
                               Text="Any Google Translate language code works, for example en, de, ru, tr, zh-CN."/>

                    <TextBlock Classes="label" Text="Your player name"/>
                    <TextBox Text="{Binding PlayerName}"/>
                    <TextBlock Classes="hint"
                               Text="Messages from this name are shown as-is and never sent for translation."/>

                    <TextBlock Classes="label" Text="Player name font size"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0"
                                Minimum="{Binding MinFontSize}"
                                Maximum="{Binding MaxFontSize}"
                                Value="{Binding NameFontSize}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1"
                                   Width="28"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Text="{Binding NameFontSize}"/>
                    </Grid>

                    <TextBlock Classes="label" Text="Translation font size"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0"
                                Minimum="{Binding MinFontSize}"
                                Maximum="{Binding MaxFontSize}"
                                Value="{Binding TranslationFontSize}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1"
                                   Width="28"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Text="{Binding TranslationFontSize}"/>
                    </Grid>

                    <CheckBox Margin="0,10,0,0"
                              IsChecked="{Binding AutoTranslate}"
                              Content="Translate incoming chat automatically"/>

                    <CheckBox IsChecked="{Binding ShowOriginalMessage}"
                              Content="Show the original message under the translation"/>

                    <CheckBox IsChecked="{Binding TranslateHistoryOnStartup}"
                              Content="Translate existing console.log history on startup"/>
                    <TextBlock Classes="hint"
                               Text="console.log keeps growing across sessions. Leaving this off avoids a burst of requests at launch, which is the usual cause of Google rate limiting."/>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>
</Window>
